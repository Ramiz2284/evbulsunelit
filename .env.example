# Скопируйте этот файл в .env.local для локальной разработки
# .env.local НЕ попадает в Git (он в .gitignore)
#
# Как получить токен бота:
#   1. Напишите @BotFather в Telegram
#   2. Отправьте /newbot и следуйте инструкциям
#   3. Скопируйте токен сюда
#
# Как получить ID канала:
#   1. Создайте канал в Telegram
#   2. Добавьте вашего бота как администратора канала
#   3. Укажите @username канала (или числовой ID вида -100xxxxxxxxxx)

VITE_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
VITE_TELEGRAM_CHANNEL_ID=@your_channel_name
